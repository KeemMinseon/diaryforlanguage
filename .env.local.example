# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Service role key — server-only, never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Anthropic — used only inside /api/review (server-side)
ANTHROPIC_API_KEY=sk-ant-...
# Optional override, defaults to claude-sonnet-5
ANTHROPIC_REVIEW_MODEL=claude-sonnet-5

# Encrypts the diary text/comments/overall-comment at rest — server-only,
# never expose to the client. Generate with: openssl rand -base64 32
DIARY_ENCRYPTION_KEY=
