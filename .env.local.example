# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Service role key — server-only, never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Anthropic — used only inside /api/review (server-side)
ANTHROPIC_API_KEY=sk-ant-...
# Optional override, defaults to claude-sonnet-5
ANTHROPIC_REVIEW_MODEL=claude-sonnet-5

# Encrypts the diary text/comments/overall-comment at rest — server-only,
# never expose to the client. Generate with: openssl rand -base64 32
DIARY_ENCRYPTION_KEY=

# Resend — used only inside /api/feedback to notify the developer by email
# when someone submits 의견 보내기. Optional: feedback is still saved to
# the `feedback` table without it, just silently (no email nudge).
RESEND_API_KEY=
# Must be a sender address on a domain verified in Resend — defaults to
# Resend's own shared onboarding@resend.dev if unset (fine for low volume).
FEEDBACK_FROM_EMAIL=

# How many accounts /api/signup-check lets in before new signups are sent
# to the waitlist instead. Optional — defaults to 30 if unset.
SIGNUP_CAP=30
